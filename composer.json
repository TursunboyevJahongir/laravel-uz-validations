{
    "name": "tursunboyevjahongir/laravel-uz-validations",
    "description": "Uzbekistan phone, PINFL, passport, vehicle registration and STIR validation rules for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "validation", "uzbekistan", "uzbek", "pinfl", "jshshir", "stir"],
    "homepage": "https://github.com/TursunboyevJahongir/laravel-uz-validations",
    "authors": [{"name": "Jahongir Tursunboyev", "homepage": "https://github.com/TursunboyevJahongir", "role": "Developer"}],
    "support": {
        "issues": "https://github.com/TursunboyevJahongir/laravel-uz-validations/issues",
        "source": "https://github.com/TursunboyevJahongir/laravel-uz-validations"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0",
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.0"
    },
    "autoload": {"psr-4": {"TursunboyevJahongir\\UzValidations\\": "src/"}},
    "autoload-dev": {"psr-4": {"TursunboyevJahongir\\UzValidations\\Tests\\": "tests/"}},
    "extra": {
        "laravel": {"providers": ["TursunboyevJahongir\\UzValidations\\UzValidationsServiceProvider"]}
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=build/coverage.xml",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
